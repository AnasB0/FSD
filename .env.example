# Najah Delivery OS - Environment Configuration
# Copy this file to .env and fill in the values

# ======================
# MongoDB Configuration
# ======================
MONGODB_URI=mongodb://mongodb:27017/najah_delivery
MONGODB_HOST=mongodb
MONGODB_PORT=27017
MONGODB_DATABASE=najah_delivery

# ======================
# Service URLs (Internal)
# ======================
EXPRESS_API_URL=http://express-api:8080
AUTH_SERVICE_URL=http://auth:8081
PAYMENTS_SERVICE_URL=http://payments:8082
INGESTION_SERVICE_URL=http://ingestion:8083
OPTIMIZER_SERVICE_URL=http://optimizer:5001
GEOCODING_SERVICE_URL=http://geocoding:5002
LLM_ASSISTANT_SERVICE_URL=http://llm-assistant:5003

# ======================
# JWT Configuration
# ======================
JWT_ACCESS_SECRET=change-this-to-a-secure-random-string-min-32-chars
JWT_REFRESH_SECRET=change-this-to-another-secure-random-string-min-32-chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ======================
# API Keys
# ======================
OPENROUTER_API_KEY=your-openrouter-api-key-here
MAPBOX_TOKEN=your-mapbox-token-here-optional

# ======================
# External Services
# ======================
OSRM_BASE_URL=http://router.project-osrm.org
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org

# ======================
# CORS Configuration
# ======================
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# ======================
# Security
# ======================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
WEBHOOK_SIGNATURE_ALGORITHM=sha256

# ======================
# Localization
# ======================
DEFAULT_LANGUAGE=en
SUPPORTED_LANGUAGES=en,ar

# ======================
# LLM Configuration
# ======================
LLM_MODEL=openai/gpt-4o-mini
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=500
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
VECTOR_STORE_TYPE=chroma

# ======================
# Logging
# ======================
LOG_LEVEL=info
NODE_ENV=development

# ======================
# Ports (for external access)
# ======================
EXPRESS_API_PORT=8080
AUTH_PORT=8081
PAYMENTS_PORT=8082
INGESTION_PORT=8083
OPTIMIZER_PORT=5001
GEOCODING_PORT=5002
LLM_ASSISTANT_PORT=5003
MERCHANT_PORTAL_PORT=3000
DRIVER_APP_PORT=3001
STREAMLIT_ADMIN_PORT=8501
