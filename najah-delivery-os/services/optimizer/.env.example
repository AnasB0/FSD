# Optimizer Service Configuration

# Service port
OPTIMIZER_PORT=5001

# OSRM routing service URL
OSRM_BASE_URL=http://router.project-osrm.org

# Maximum number of orders per route
MAX_ORDERS_PER_ROUTE=10

# Maximum route duration in hours
MAX_ROUTE_DURATION_HOURS=8

# Default service time per stop in minutes
DEFAULT_SERVICE_TIME_MINUTES=5

# Flask debug mode (set to True for development)
FLASK_DEBUG=False
