# Server Configuration
NODE_ENV=development
PORT=3003
LOG_LEVEL=info

# Database
MONGODB_URI=mongodb://localhost:27017/payments

# Security
JWT_SECRET=your-super-secret-jwt-key-change-in-production
WEBHOOK_SECRET=your-webhook-signing-secret-from-payment-gateway

# CORS
CORS_ORIGIN=http://localhost:3000

# Payment Gateway Configuration (STUB values)
# In production, replace with actual gateway credentials

# MADA/Hyperpay Configuration
HYPERPAY_ENTITY_ID=your-entity-id
HYPERPAY_ACCESS_TOKEN=your-access-token
HYPERPAY_BASE_URL=https://test.oppwa.com

# STC Pay Configuration
STC_PAY_MERCHANT_ID=your-merchant-id
STC_PAY_API_KEY=your-api-key
STC_PAY_BASE_URL=https://api.stcpay.com.sa

# Payment Gateway URLs
PAYMENT_GATEWAY_URL=https://payment-gateway.example.com

# Webhook URLs (for gateway callbacks)
WEBHOOK_BASE_URL=https://your-domain.com/api/payments/webhook

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Reconciliation
RECONCILIATION_SCHEDULE=0 2 * * *
