# Server Configuration
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Database
MONGODB_URI=mongodb://localhost:27017/najah_delivery
MONGODB_OPTIONS=retryWrites=true&w=majority

# JWT Configuration
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRY=24h
JWT_ISSUER=najah-delivery-api

# CORS Configuration
CORS_ORIGIN=http://localhost:3000,http://localhost:8080
CORS_CREDENTIALS=true

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Service URLs
AUTH_SERVICE_URL=http://localhost:5001
GEOCODING_SERVICE_URL=http://localhost:5002
OPTIMIZER_SERVICE_URL=http://localhost:5003
ASSISTANT_SERVICE_URL=http://localhost:5004

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

# API Configuration
API_PREFIX=/api/v1
REQUEST_TIMEOUT=30000

# Security
HELMET_ENABLED=true
TRUST_PROXY=false

# Default Language
DEFAULT_LANGUAGE=ar
SUPPORTED_LANGUAGES=ar,en
