# Najah Delivery OS Environment Configuration
# Copy this file to .env and fill in your values

# ============================================
# Global Configuration
# ============================================
NODE_ENV=development
LOG_LEVEL=info

# ============================================
# MongoDB Configuration
# ============================================
MONGO_URI=mongodb://mongo:27017/najah_delivery
MONGO_TEST_URI=mongodb://mongo:27017/najah_delivery_test

# ============================================
# JWT Secrets (Change in production!)
# ============================================
JWT_ACCESS_SECRET=najah_access_secret_change_in_production
JWT_REFRESH_SECRET=najah_refresh_secret_change_in_production
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ============================================
# API Keys & External Services
# ============================================
# OpenRouter API Key for LLM Assistant (Required)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Mapbox Token for Frontend Maps (Optional)
MAPBOX_TOKEN=your_mapbox_token_here

# OSRM Server (Default: public demo server)
OSRM_BASE_URL=https://router.project-osrm.org

# Nominatim Geocoding (Default: public OSM server)
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org

# ============================================
# Service URLs (Internal Docker Network)
# ============================================
EXPRESS_API_URL=http://express-api:8080
AUTH_SERVICE_URL=http://auth:8081
PAYMENTS_SERVICE_URL=http://payments:8082
INGESTION_SERVICE_URL=http://ingestion:8083
OPTIMIZER_SERVICE_URL=http://optimizer:5001
GEOCODING_SERVICE_URL=http://geocoding:5002
LLM_ASSISTANT_URL=http://llm-assistant:5003

# ============================================
# Service Ports (External)
# ============================================
EXPRESS_API_PORT=8080
AUTH_PORT=8081
PAYMENTS_PORT=8082
INGESTION_PORT=8083
OPTIMIZER_PORT=5001
GEOCODING_PORT=5002
LLM_ASSISTANT_PORT=5003
MERCHANT_PORTAL_PORT=3000
DRIVER_APP_PORT=3001
STREAMLIT_ADMIN_PORT=8501

# ============================================
# CORS Configuration
# ============================================
CORS_ORIGIN=http://localhost:3000,http://localhost:3001,http://localhost:8501

# ============================================
# Rate Limiting
# ============================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ============================================
# Security & Webhooks
# ============================================
# Default merchant webhook secret (change per merchant)
WEBHOOK_SECRET=default_webhook_secret_change_this

# ============================================
# Payment Configuration
# ============================================
PAYMENT_PROVIDER=stub
MADA_API_KEY=mada_api_key_here
STC_PAY_API_KEY=stc_pay_api_key_here

# ============================================
# LLM Configuration
# ============================================
LLM_MODEL=openai/gpt-4o-mini
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=500
VECTOR_STORE_TYPE=chroma
CHROMA_PERSIST_DIR=/app/data/chroma

# ============================================
# Optimizer Configuration
# ============================================
MAX_ORDERS_PER_ROUTE=20
MAX_ROUTE_DURATION_HOURS=8
DEFAULT_SERVICE_TIME_MINUTES=10

# ============================================
# Geocoding Configuration
# ============================================
GEOCODING_TIMEOUT_SECONDS=5
DEFAULT_COUNTRY=SA
DEFAULT_CITY=Riyadh

# ============================================
# i18n Configuration
# ============================================
DEFAULT_LANGUAGE=en
SUPPORTED_LANGUAGES=en,ar

# ============================================
# Docker Resource Limits (for 8GB RAM system)
# ============================================
# These are configured in docker-compose.yaml
# Adjust based on your system resources

# ============================================
# AWS Deployment (Terraform)
# ============================================
AWS_REGION=me-south-1
AWS_INSTANCE_TYPE=t3.medium
AWS_KEY_NAME=your-key-pair-name
AWS_VPC_CIDR=10.0.0.0/16

# ============================================
# Monitoring & Observability
# ============================================
ENABLE_METRICS=false
ENABLE_TRACING=false
SENTRY_DSN=

# ============================================
# Feature Flags
# ============================================
ENABLE_CACHE=false
ENABLE_RATE_LIMIT=true
ENABLE_REQUEST_LOGGING=true
